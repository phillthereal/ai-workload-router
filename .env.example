# Copy this file to .env and fill in your actual API keys

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
OPENAI_API_KEY=sk-...

# Google Generative AI (Gemini)
GOOGLE_API_KEY=AIza...

# DeepSeek API
DEEPSEEK_API_KEY=sk-...

# Moonshot (Kimi K3)
MOONSHOT_API_KEY=sk-...

# TypeSafe (Jev decision model)
TYPESAFE_API_KEY=

# Docker only (see docs/DOCKER.md). Leave unset for free demo mode.
# 1 = make real, billed model calls with the keys above.
AWR_WEB_ALLOW_PAID=
AWR_WEB_DAILY_BUDGET_USD=0.50
